# Copie ce fichier en .env puis remplis les valeurs (toutes facultatives).

# Import Spotify complet (sans limite de 100 titres) :
# 1. https://developer.spotify.com/dashboard > Create app (Redirect URI : http://127.0.0.1:5173)
# 2. Coche "Web API", puis copie le Client ID et le Client Secret ici.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Recherche YouTube via l'API officielle (sinon : sans clé)
YOUTUBE_API_KEY=
